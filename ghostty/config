theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-family = IosevkaTerm Nerd Font
font-size = {{ghostty_font_size}}

background-opacity = 0.9
background-blur-radius = 20

{{#if ghostty_command}}
command = {{ghostty_command}}
{{/if}}

macos-option-as-alt = true

keybind = ctrl+equal=unbind
keybind = ctrl++=unbind
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift++=increase_font_size:1

keybind = ctrl+-=unbind
keybind = ctrl+shift+-=decrease_font_size:1

keybind = ctrl+0=unbind
keybind = ctrl+shift+0=reset_font_size

keybind = ctrl+,=unbind
keybind = ctrl+shift+,=open_config

shell-integration-features = ssh-env,ssh-terminfo
