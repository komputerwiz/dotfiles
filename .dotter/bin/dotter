#!/bin/bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" > /dev/null && pwd)"

if [ ! -f "$DIR/.dotter-version" ]; then
	echo "dotter version file (.dotter-version) missing" >&2
	exit 1
fi

VERSION="${DOTTER_VERSION:-"$(cat "$DIR/.dotter-version")"}"

if [[ "$OSTYPE" == darwin* ]]; then
  OS=darwin
elif [[ "$OSTYPE" == linux-gnu* ]]; then
  OS=linux
fi

ARCH="$HOSTTYPE"

if [[ "$ARCH" == "arm64" ]]; then
  ARCH=aarch64
fi

EXE="$DIR/dotter-$VERSION-$OS-$ARCH"

if test ! -x "$EXE"; then
  echo "dotter exec not found for OS ($OS) and arch ($ARCH)" >&2
  exit 1
fi

"$EXE" "$@"
