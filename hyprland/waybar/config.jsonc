{
	"position": "top",
	"height": 30,
	"spacing": 10,

	"modules-left": [
		"custom/launcher",
		"hyprland/workspaces",
		"hyprland/submap",
	],
	"modules-center": [
		"hyprland/window",
	],
	"modules-right": [
		"clock",
		"custom/power",
	],

	"reload_style_on_change": true,

	// module config
	"clock": {
		"interval": 10,
		"format": "{:%H:%M}",
		"format-alt": "{:%a %b %d}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"format": {
				"today": "<span color='#268bd2'><b>{}</b></span>",
			},
		},
	},

	"hyprland/window": {
		"separate-outputs": true,
	},

	"hyprland/workspaces": {
		"format": "{icon}",
		"on-scroll-up": "hyprctl dispatch workspace e+1",
		"on-scroll-down": "hyprctl dispatch workspace e-1",
	},

	"custom/launcher": {
		"format": "󰣇 ",
		"tooltip": false,
		"on-click": "wofi --show drun",
	},

	"custom/power": {
		"format": "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "systemctl poweroff",
			"reboot": "systemctl reboot",
			"logout": "hyprctl dispatch exit",
		},
	},
}
